# Example development configuration for CUSTOS.
#
# DO NOT EDIT THIS FILE TO RUN THE SYSTEM. Copy it, or better: generate the
# real one, which produces a fresh JWT secret and per-operator salted hashes:
#
#     backend\.venv\Scripts\python.exe backend\scripts\bootstrap_env.py
#     (or: python3 backend/scripts/bootstrap_env.py)
#
# scripts\setup_windows.bat does this for you on first run.
#
# The three REPLACE-ME values above are deliberately invalid: a placeholder
# secret that still authenticates is worse than one that refuses to boot.

CUSTOS_ENVIRONMENT=development
CUSTOS_DATABASE_URL=sqlite+aiosqlite:///./custos_dev.db
CUSTOS_LOG_LEVEL=INFO
CUSTOS_JWT_SECRET=REPLACE-ME-generate-with-scripts-bootstrap_env.py
CUSTOS_API_KEYS=REPLACE-ME-ingest-key:ingest
CUSTOS_OPERATOR_ROSTER=REPLACE-ME-subject:hash$salt:role;subject:hash$salt:role
CUSTOS_SIM_ENSEMBLE_SIZE=24
CUSTOS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CUSTOS_AI_ENABLED=true
