# ---------------------------------------------------------------------------
# CUSTOS backend configuration (copy to .env and edit)
# Every variable is prefixed CUSTOS_ and is optional; defaults are safe for a
# single-node EOC deployment. NEVER commit a real .env.
# ---------------------------------------------------------------------------

CUSTOS_ENVIRONMENT=development            # development | staging | production
CUSTOS_LOG_LEVEL=INFO

# --- City profile (the MVP is scoped to one city) --------------------------
CUSTOS_CITY_ID=kochi
CUSTOS_CITY_NAME=Kochi (Ernakulam)
CUSTOS_CITY_TIMEZONE=Asia/Kolkata
# min_lon,min_lat,max_lon,max_lat
CUSTOS_CITY_BBOX=76.18,9.85,76.42,10.12

# --- Database --------------------------------------------------------------
# PostgreSQL is the production target. The SQLite URL is a degradation path
# for field laptops / single-node EOC fallback, never for multi-operator use.
CUSTOS_DATABASE_URL=postgresql+psycopg://custos:custos@127.0.0.1:5432/custos
# CUSTOS_DATABASE_URL=sqlite+aiosqlite:///./custos_dev.db
CUSTOS_DB_POOL_SIZE=10
CUSTOS_DB_MAX_OVERFLOW=20
CUSTOS_DB_STATEMENT_TIMEOUT_MS=15000
CUSTOS_AUTO_MIGRATE=true

# --- Local AI (on-premise, air-gap friendly) -------------------------------
CUSTOS_AI_ENABLED=true
CUSTOS_OLLAMA_BASE_URL=http://127.0.0.1:11434
CUSTOS_OLLAMA_MODEL=qwen2.5:7b-instruct
CUSTOS_OLLAMA_TIMEOUT_S=45
CUSTOS_OLLAMA_MAX_CONCURRENCY=2
CUSTOS_AI_REQUIRE_GROUNDING=true

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
CUSTOS_JWT_SECRET=
CUSTOS_ACCESS_TOKEN_TTL_S=3600
CUSTOS_REFRESH_TOKEN_TTL_S=43200
# Machine ingestion keys, "key:role" pairs. Rotate per deployment.
# CUSTOS_API_KEYS=ingest-local-0123456789abcdef:ingest,ops-mirror-abcdef0123456789:analyst
CUSTOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CUSTOS_RATE_LIMIT_RPM=600

# --- Simulation defaults ---------------------------------------------------
CUSTOS_SIM_ENSEMBLE_SIZE=48
CUSTOS_SIM_MAX_ENSEMBLE_SIZE=400
CUSTOS_SIM_HORIZON_MINUTES=360
CUSTOS_SIM_TIMESTEP_MINUTES=15
CUSTOS_SIM_MAX_CONCURRENCY=3

# --- Data fusion / connectors ---------------------------------------------
CUSTOS_ENABLE_LIVE_CONNECTORS=false      # synthetic feeds when false
CUSTOS_WEATHER_API_URL=
CUSTOS_SENSOR_STREAM_URL=
CUSTOS_UTILITY_API_URL=
CUSTOS_POLL_INTERVAL_S=30
CUSTOS_SEED_ON_STARTUP=true
